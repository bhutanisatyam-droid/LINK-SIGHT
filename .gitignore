# PyInstaller — ignore intermediate build artifacts and bundled runtime DLLs
# but ALLOW the compiled .exe so judges can see it on GitHub
build/
dist/*/_internal/
*.spec

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
venv/
env/
ENV/

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
